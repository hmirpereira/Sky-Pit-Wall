  </div>

  <script type="module">
      import Webamp from "https://unpkg.com/webamp@0.0.0-next-0882aa7";
      const webamp = new Webamp({    
          windowLayout: {
            main: {
              position: { top: 20, left: 0 },
              shadeMode: true,
            },
            playlist: {
              position: { top: 30, left: 0 },
              shadeMode: true,
              closed: false,
            },
          }, 
          availableSkins: [
            {
              url: "https://archive.org/cors/winampskin_Green-Dimension-V2/Green-Dimension-V2.wsz",
              name: "Green Dimension V2",
            },
            {
              url: "https://archive.org/cors/winampskin_mac_os_x_1_5-aqua/mac_os_x_1_5-aqua.wsz",
              name: "Mac OSX v1.5 (Aqua)",
            },
        ],
        initialTracks: [
          {
            metaData: {
              artist: "The Weather Channel",
              title: "Presents: The Best of Smooth Jazz (full album)",
            },
            // one 53-minute file on the Internet Archive (the page only links to it)
            url: "https://archive.org/download/the-weather-channel-presents-the-best-of-smooth-jazz-full-album/The%20Weather%20Channel%20Presents%20-%20The%20Best%20of%20Smooth%20Jazz%20%28FULL%20ALBUM%29.mp3",
            duration: 3164,
          },
        ],
      });

      // Expose it globally for setting.mjs
      window.webamp = webamp;

      webamp.setVolume(100);
      webamp.toggleRepeat();
      webamp.toggleShuffle();

      webamp.renderWhenReady(document.getElementById("webamp-app"));
  </script>
  <script>
    (function () {
      // Parse bootstrapped JSON from a dedicated script tag to avoid template parsing issues
      const initialJson = document.getElementById('initial-data') && document.getElementById('initial-data').textContent;
      let initial = null;
      try {
        initial = initialJson ? JSON.parse(initialJson) : null;
      } catch (e) {
        initial = null;
      }

      // Minimal renderer: update a few visible fields. Modules can listen for 'custom-weather:update' event for more complex updates
      function applyPayload(payload) {
        if (!payload) return;
        try {
          if (payload.locationCity) document.getElementById('customSpanStationId').textContent = payload.locationCity;
          if (payload.lastUpdated) document.getElementById('customSpanLastRefresh').textContent = payload.lastUpdated;

          // Dispatch a global event so module code can react instead of coupling here
          window.dispatchEvent(new CustomEvent('custom-weather:update', { detail: payload }));
        } catch (e) {
          // defensive: DOM may not be present yet
        }
      }

      // Apply initial bootstrapped data if present
      applyPayload(initial);

      // Live updates using Server-Sent Events
      if (typeof EventSource !== 'undefined') {
        const es = new EventSource('/events');
        es.onmessage = (e) => {
          try {
            const parsed = JSON.parse(e.data);
            if (parsed && parsed.type === 'weather-update') {
              console.log('Received weather update via SSE', parsed);
              applyPayload(parsed.payload);
            }
          } catch (err) {
            console.error('SSE parse error', err);
          }
        };
        es.onerror = () => {
          // optional: reconnect logic could go here
        };
      }
    })();
  </script>
</body>

</html>